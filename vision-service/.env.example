# Copy to vision-service/.env and fill in. Never commit the real .env.

# mock | ollama | oci | openai
#   mock   = canned answers, no model at all (UI work)
#   ollama = a vision model running on this computer, no cloud account (see docs/video-intake.md)
VISION_PROVIDER=mock

# video  = send the whole clip with audio to a video-capable model (recommended: Gemini on OCI)
# frames = send sharp keyframes + a transcript (for image-only models such as Llama 4 on OCI)
INPUT_MODE=video

# --- Local models (VISION_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5vl:7b needs ~6 GB RAM/VRAM; on a slow laptop try qwen2.5vl:3b
OLLAMA_MODEL=qwen2.5vl:7b
# Longest side of each frame sent to the model; smaller = faster on CPU
OLLAMA_IMAGE_PX=672
OLLAMA_NUM_CTX=16384
OLLAMA_TIMEOUT_S=600
# true = tile all keyframes into one image (much faster on CPU, less detail)
FRAMES_AS_SHEET=false
# Speech for frames mode when the browser sent no live captions:
# TRANSCRIBE_PROVIDER=local uses faster-whisper on this computer (pip install -r requirements-local.txt)
# tiny | base | small | medium  (small is a good balance; handles English, Spanish and Chinese)
WHISPER_MODEL_SIZE=small

# --- OCI Generative AI ---
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxx
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
# Video mode: google.gemini-2.5-flash (or google.gemini-2.5-pro)
# Frames mode: meta.llama-4-maverick-17b-128e-instruct-fp8, meta.llama-3.2-90b-vision-instruct
OCI_MODEL_ID=google.gemini-2.5-flash

# --- Optional: any OpenAI-compatible endpoint (frames mode) and Whisper-style transcription ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# local | openai | none   (only used in frames mode when the browser sent no live transcript)
TRANSCRIBE_PROVIDER=none
TRANSCRIBE_MODEL=whisper-1

NUM_KEYFRAMES=8
MAX_VIDEO_SECONDS=120
MAX_UPLOAD_MB=200
