# Copy to backend/.env and fill in. Never commit the real .env.

# mock | oci | openai   (mock needs no credentials; good for UI work)
VISION_PROVIDER=mock

# video  = send the whole clip with audio to a video-capable model (recommended: Gemini on OCI)
# frames = send sharp keyframes + a transcript (for image-only models such as Llama 4 on OCI)
INPUT_MODE=video

# --- OCI Generative AI ---
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..xxxx
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
# Video mode: google.gemini-2.5-flash (or google.gemini-2.5-pro)
# Frames mode: meta.llama-4-maverick-17b-128e-instruct-fp8, meta.llama-3.2-90b-vision-instruct
OCI_MODEL_ID=google.gemini-2.5-flash

# --- Optional: any OpenAI-compatible endpoint (frames mode) and Whisper-style transcription ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# openai | none   (only used in frames mode when the browser sent no live transcript)
TRANSCRIBE_PROVIDER=none
TRANSCRIBE_MODEL=whisper-1

NUM_KEYFRAMES=8
MAX_VIDEO_SECONDS=120
MAX_UPLOAD_MB=200
