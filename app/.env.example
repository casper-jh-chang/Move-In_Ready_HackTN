PORT=3001

# MySQL (required). Create the database and an app user first; see README "Database setup".
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=movein
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=furnishflow

# AI video intake: the Python service in ../vision-service (its own .env picks the model).
VISION_SERVICE_URL=http://127.0.0.1:8000
VISION_MAX_UPLOAD_MB=200
# Local models can take minutes per video
VISION_TIMEOUT_S=900
