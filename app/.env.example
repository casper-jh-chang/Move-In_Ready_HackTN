PORT=3001

# MySQL (required). Create the database and an app user first; see README "Database setup".
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=movein
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=furnishflow

# Photo scan (OCI AI Vision + OCI Generative AI). Uses the API-key profile in ~/.oci/config
# (user, fingerprint, tenancy, region, key_file). Leave these unset to use that file as-is.
# OCI_CONFIG_FILE=~/.oci/config
# OCI_PROFILE=DEFAULT
# OCI_COMPARTMENT_ID=          # defaults to the tenancy (root compartment)
# OCI_VISION_MODEL=meta.llama-4-maverick-17b-128e-instruct-fp8
# OCI_VISION_DISABLED=1        # turn photo scanning off

# Road routing and geocoding (free OpenStreetMap services, no API key). Point these at your own
# OSRM / Nominatim servers for heavier use.
# OSRM_URL=https://router.project-osrm.org
# GEOCODER_URL=https://nominatim.openstreetmap.org

# AI video intake: the Python service in ../vision-service (its own .env picks the model).
VISION_SERVICE_URL=http://127.0.0.1:8000
VISION_MAX_UPLOAD_MB=200
# Local models can take minutes per video
VISION_TIMEOUT_S=900
